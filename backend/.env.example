# Gmail (use an App Password, NOT your real password)
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=youremail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Groq (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Twilio WhatsApp Sandbox (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
STUDENT_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# MongoDB (optional — leave blank to run with in-memory storage for the demo)
MONGO_URI=
