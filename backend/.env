# ============================================================
# DATABASE — MongoDB, stores the app data (persists across restarts)
# ============================================================
# Local:  install MongoDB Community Server and leave this as-is, or
# Cloud:  create a free cluster at https://www.mongodb.com/cloud/atlas/register
#         and paste its connection string here.
MONGODB_URI=mongodb+srv://PreppilotUser:pr123@cluster0.5pte6gt.mongodb.net/?appName=Cluster0

# ============================================================
# GEMINI — powers the email classification/extraction AI
# ============================================================
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ============================================================
# GOOGLE OAUTH — required for REAL Gmail reading (not the demo mode)
# ============================================================
# From Google Cloud Console > APIs & Services > Credentials
# Create a "Web application" OAuth Client ID.
# Authorized redirect URI MUST be exactly: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=740930190910-etc6v2vnhchvt5i3djvh6q7t3jmqstjj.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ============================================================
# OTP EMAIL SENDING — pick ONE of the options below
# ============================================================
# Option A (recommended): Resend — simplest, most reliable
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_ELP91BMH_KpM1a2CAHmPY2kCH298ZppC6

# Option B: Gmail SMTP with an App Password
# Generate at: https://myaccount.google.com/apppasswords (needs 2FA enabled)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Gmail REST API using OAuth tokens (only needed if you don't use Option A)
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=

# ============================================================
# WHATSAPP (optional, for notification delivery)
# ============================================================
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================================
# SERVER CONFIG
# ============================================================
PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173